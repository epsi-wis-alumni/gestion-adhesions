{% extends 'base.html.twig' %}
{% import 'macros/badge.html.twig' as badge %}
{% import 'macros/image.html.twig' as image %}
{% import 'macros/fontawesome.html.twig' as fa %}
{% import "macros/progress.html.twig" as progress %}
{% import "macros/modal.html.twig" as modal %}
{% block title %}
  Élection {{ election.jobTitle }}
{% endblock %}

{% block body %}
  <div class="container mt-3 mb-5">
    <nav class="mb-3" aria-label="breadcrumb">
      <ol class="breadcrumb bg-body px-3 py-3 mb-0 border rounded shadow-sm">
        <li class="breadcrumb-item"><a href="{{ path('app_election_index') }}">Élections</a></li>
        <li class="breadcrumb-item active" aria-current="page">Élection {{ election.jobTitle }}</li>
      </ol>
    </nav>

    <div class="row">
      <div class="col-md-5 col-lg-3">
        <div class="card">
          <div class="card-body">
            <div class="card-text h1">{{ election.jobTitle }}</div>

            <ul class="list-unstyled gy-3">
              <li class="row align-items-center gx-2">
                <div class="col-auto">
                  {{ fa.icon('user-tie', fixed_width: true, size: 'xl', additional_classes: ['text-primary-emphasis']) }}
                </div>
                <div class="col">
                  <div>{{ badge.emphasis('Poste') }}</div>
                  <div class="text-secondary">
                    {{ election.jobTitle }}
                  </div>
                </div>
              </li>
              <li class="row align-items-center gx-2">
                <div class="col-auto">
                  {{ fa.icon('calendar-check', fixed_width: true, size: 'xl', additional_classes: ['text-primary-emphasis']) }}
                </div>
                <div class="col">
                  <div>{{ badge.emphasis('Début du vote') }}</div>
                  <div class="text-secondary">
                    {{ election.voteStartAt ? election.voteStartAt|date('Y/m/d H:i') : '' }}
                  </div>
                </div>
              </li>
              <li class="row align-items-center gx-2">
                <div class="col-auto">
                  {{ fa.icon('calendar-xmark', fixed_width: true, size: 'xl', additional_classes: ['text-primary-emphasis']) }}
                </div>
                <div class="col">
                  <div>{{ badge.emphasis('Fin du vote') }}</div>
                  <div class="text-secondary">
                    {{ election.voteEndAt ? election.voteEndAt|date('Y/m/d H:i') : '' }}
                  </div>
                </div>
              </li>
            </ul>

            {{ progress.election(step) }}
          </div>
        </div>
      </div>

      <div class="col">

        {% if election.isClosed %}
          <div class="mb-4">
            <h3 class="h2">Résultats</h3>
            <div class="row justify-content-start gap-3 mb-3">
              {% for winner in winners %}
                <div class="col-md-6">
                  <div class="card text-start">
                    <div class="card-body">
                      <div class="display-5 text-secondary fw-bold mb-3">
                        {{ votecount ? winner.votes|length / voteCount * 100 : 0 }} %
                      </div>
                      <h5 class="card-title">{{ winner.candidate.displayName }}</h5>
                      <div 
                        class="progress" 
                        role="progressbar" 
                        aria-label="Résultats de {{ winner.candidate.displayName }}" 
                        aria-valuenow="{{ winner.votes|length }}"
                        aria-valuemin="0" 
                        aria-valuemax="{{ voteCount }}"
                      >
                        <div class="progress-bar bg-success" style="width: {{ {% if votecount == 0 %} 0 {% else %} winner.votes|length / voteCount * 100 {% endif %} }}%;">
                          {{ winner.votes|length }} / {{ voteCount }}
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <h3 class="h2 row g-2 align-items-center">
          <div class="col-auto">
            Candidats
          </div>

          {% if election.isPending and not hasCandidated %}
            <div class="col-auto">
              <a href="{{ path('app_election_candidate', { id: election.id }) }}" class="btn btn-primary">
                {{ fa.icon('person-sign') }}
                Postuler
              </a>
            </div>
          {% elseif election.isPending and hasCandidated %}
            <div class="col-auto">
              <a href="{{ path('app_election_candidate', { id: election.id }) }}" class="btn btn-primary">
                {{ fa.icon('pen-to-square') }}
                Modifier ma candidature
              </a>
            </div>
          {% endif %}
        </h3>

        <div class="table-responsive border rounded mb-3">
          <table class="table table-striped mb-0">
            <thead class="table-bordered">
              <tr>
                <th>Nom</th>
                <th>Prénom</th>
                {% if election.isClosed %}
                  <th>Pourcentage de votes sur {{ voteCount }} votes</th>
                {% endif %}
                <th>Actions</th>
              </tr>
            </thead>
            <tbody class="align-middle">
              {% for candidacy in results %}
                <tr>
                  <td>{{ candidacy.candidate.lastname }}</td>
                  <td>{{ candidacy.candidate.firstname }}</td>
                  
                  {% if election.isClosed %}
                    <td {% if candidacy in winners %}class="text-success fw-bold"{% endif %}>
                      {{ votecount ? (candidacy.votes|length / voteCount * 100)|round(2) : 0 }} %
                      <div 
                        class="progress" 
                        role="progressbar" 
                        aria-label="Résultats de {{ candidacy.candidate.displayName }}" 
                        aria-valuenow="{{ candidacy.votes|length }}"
                        aria-valuemin="0" 
                        aria-valuemax="{{ voteCount }}"
                      >
                        <div class="progress-bar bg-{{ candidacy in winners ? 'success':'secondary' }}" style="width: {{ {% if votecount == 0 %} 0 {% else %} winner.votes|length / voteCount * 100 {% endif %} }}%;">
                          {{ candidacy.votes|length }} / {{ voteCount }} votes
                        </div>
                      </div>
                    </td>
                  {% endif %}
                  
                  <td>
                    <div class="d-flex align-items-center gap-2">
                      {% set modalId = 'confirmAlert-' ~ candidacy.id %}
                      <a class="link-primary" data-bs-toggle="modal" data-bs-target="#{{ modalId }}" href="#">
                        {{ fa.icon('circle-info') }}
                      </a>
                      {{ modal.confirm(
                        id: modalId,
                        title: candidacy.candidate.displayName,
                        avatar: candidacy.candidate.avatar,
                        description: candidacy.presentation,
                      ) }}
                      
                      {% if not election.isClosed and not hasVoted %}
                        {% set modalId = 'confirmAlert-vote-' ~ election.id %}
                        <a class="link-primary" data-bs-toggle="modal" data-bs-target="#{{ modalId }}" href="#">
                          {{ fa.icon('check-to-slot') }}
                        </a>
                        {{ modal.confirm(
                          id: modalId,
                          path: path('app_election_vote', { id: election.id, candidacyId: candidacy.id }),
                          title: 'Êtes-vous sûr de vouloir voter ?',
                          continueButton: 'Voter'
                        ) }}
                      {% endif %}

                      {% if is_granted('CANDIDACY_DELETE', candidacy) %}
                        {% set modalDeleteId = 'confirmAlert-delete-' ~ candidacy.id %}
                          <form method="post" action="{{ path('app_election_candidacy_delete', { id: candidacy.id }) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ candidacy.id) }}" />
                            <a class="bg-transparent border-0 link-danger" data-bs-toggle="modal" data-bs-target="#{{ modalDeleteId }}" href="#">
                              {{ fa.icon('trash-can') }}
                            </a>
                            {{ modal.confirm(
                              id: modalDeleteId,
                              title: 'Voulez vous vraiment supprimer la candidature ?',
                              continueButton: 'Supprimer',
                              type: 'submit',
                              accent: 'danger',
                            ) }}
                          </form>
                      {% endif %}
                    </div>
                    
                  </td>
                </tr>
              {% else %}
                <tr>
                  <td colspan={{ election.isClosed ? '4' : '3' }}>Aucun candidat</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
