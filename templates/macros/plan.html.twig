{% macro plan(title, description, features = [], price, path, highlight, current) %}
  {% import "macros/fontawesome.html.twig" as fa %}

  {% set accent = highlight ? 'primary' : 'secondary' %}
  {% set border = highlight  ? 'highlight' : '' %}
  {% set badge = highlight  ? 'current badge text-bg-success' : 'd-none' %}

  <div class="card mb-4 {{ border }}">
    <div class="card-body">

      <h3 class="card-title text-center mb-3"   {% if current %} {{ stimulus_controller('tooltip')}} {% endif %}>
        {{ title }} 
        
        {% if current %}
          <span class="text-success cursor-pointer"
            data-bs-toggle="tooltip" 
            data-bs-placement="top"  
            data-bs-custom-class="custom-tooltip" 
            data-bs-title="Adhésion active"> 
              {{ fa.icon('circle-check', size: 'sm') }}
          </span>
        {% endif %}
      </h3>

      <div class="card-text text-secondary text-center mb-3">
        {{ description }}
      </div>

      {% for feature in features %}
        <div class="d-flex align-items-center gap-2 mb-2 lh-1">
          {{ fa.icon('arrow-right') }}
          <div>
            {{ feature.name }}
          </div>
        </div>
      {% endfor %}

      <div class="card-text text-{{ accent }} text-center fs-4 fw-bold my-3">
        {{ price|number_format(2, '.', ' ') }} €
      </div>

      <div class="text-center">
          {% if current %}
            <a href="{{ path('app_user_plan') }}#activePlan" class="btn btn-{{ accent }}" data-turbo="false">
              {{ fa.icon('gear') }}
              Gérer
            </a>
          {% else %}
            <a href="{{ path }}" class="btn btn-{{ accent }}" data-turbo="false">
              {{ fa.icon('circle-info') }}
              Choisir
            </a>
          {% endif %}
      </div>
    </div>
  </div>
{% endmacro %}