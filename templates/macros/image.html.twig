{% macro avatar(path, alt, size = 'md', additional_classes = []) %}
  {% import "macros/fontawesome.html.twig" as fa %}
  
  {%- set classes = ['avatar', 'avatar-' ~ size, 'link-primary', 'lh-1'] -%}
  {%- set classes = classes|merge(additional_classes) -%}
  {%- set icon_size = 'fa-' ~ size %}

  <span class="{{ classes|join(' ') }}">
    <img 
      src="{{ path }}" 
      alt="{{ alt }}" 
      class="rounded-pill border"
      onerror="
        this.style.display='none';
        if (this.nextElementSibling === null) this.insertAdjacentHTML(
          'afterend', 
          '{{ fa.icon('user-circle', size='icon_size') | e('js') }}'
        );
      "
    >
  </span>
{% endmacro %}