{% extends 'base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}

{% block title %}
  {{ base_title }} - Informations complémentaires
{% endblock %}

{% block body %}
  <div class="container">
    <div class="mx-auto" style="max-width: 24rem;">
      {{ form_start(form) }}
        <div class="row">
          <div class="col-md-6">
            {{ form_row(form.firstname) }}
          </div>
          <div class="col-md-6">
            {{ form_row(form.lastname) }}
          </div>
        </div>
        {{ form_row(form.company) }}
        {{ form_row(form.jobTitle) }}
        <div class="text-end">
            <button type="submit" class="btn btn-primary">
                {{ fa.icon('save') }}
                Enregistrer
            </button>
        </div>
      {{ form_end(form) }}
    </div>
  </div>
{% endblock %}
