{% import "macros/plan.html.twig" as plan_card %}

<div class="container">
    <div class="row align-items-center gap-5 my-5">
        {% for plan in plans %}
            {% if activePlan %}
                {% set current = plan.name == activePlan.name ? true : false %}
            {% else %}
                {% set current = false %}
            {% endif %}
            
            <div class="col">
                {{ plan_card.plan(
                    title: plan.name,
                    description: plan.description,
                    features: plan.features,
                    price: plan.price,
                    highlight: plan.highlighted,
                    current: current
                )}}
            </div>
        {% endfor %}
    </div>
</div>