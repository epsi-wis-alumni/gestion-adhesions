{% extends 'user/base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}

{% set date_format = 'd/m/Y' %}

{% block profile_content %}
<div class="container-fluid">
    <h1 class="h1 text-center mt-2">
        Plan{% if (currentUser.firstname|lower|first) in ['a', 'e', 'i', 'o', 'u', 'y'] %}
        d'{{ currentUser.firstname|capitalize }}
        {% else %}
        de {{ currentUser.firstname|capitalize }}
        {% endif %}
    </h1>
    {% include "/plan/_plan.html.twig" %}
    <h2 class="fs-1 text-center my-2">Plan actif</h2>
    <div class="row d-flex justify-content-center">
        <div class="col-6 d-flex flex-column align-items-center gap-3">
            <div class="mt-2">
                {% if renewalUpdated == "add" %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        Renouvellement <span class="fw-bolder">activé</span> avec succès.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endif %}
                {% if renewalUpdated == "remove" %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        Renouvellement <span class="fw-bolder">désactivé</span> avec succès.
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                {% endif %}
            </div>

            <div class="">Date de l'abonnement : <span class="fw-bold">{{ activeTransaction.createdAt|date(date_format) }}</span></div>
            <div class="">Date renouvellement de l'abonnement : <span class="fw-bold">{{ activeTransaction.renewal ? activeTransaction.createdAt|date_modify('+1 year')|date(date_format) : "Inactif" }}</span></div>
            <div class="">Tarif : <span class="fw-bold">{{ activeTransaction.amount|number_format(2, '.', ' ') }} €</span></div>

            {{ form_start(renewalForm) }}
                {{ form_row(renewalForm.renewal) }}
                <button type="submit" class="btn btn-{{ activeTransaction.renewal ? "danger" : "success"}} mt-3">
                    {{ fa.icon(activeTransaction.renewal ? "circle-pause" : "circle-play") }}
                    <span class="ms-1">{{ activeTransaction.renewal ? "Désactiver" : "Activer"}} le renouvellement</span>
                </button>
            {{ form_end(renewalForm) }}
        </div>
    </div>
</div>

{% endblock %}