{% extends 'user/base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}
{% import "macros/plan.html.twig" as plan_card %}

{% block profile_content %}
<div class="container-fluid">
    <div class="h1 text-center mt-2">
        Plan{% if (currentUser.firstname|lower|first) in ['a', 'e', 'i', 'o', 'u', 'y'] %}
        d'{{ currentUser.firstname|capitalize }}
        {% else %}
        de {{ currentUser.firstname|capitalize }}
        {% endif %}
    </div>
    <div class="container d-flex align-items-center gap-5 my-5">
        {% for plan in plans %}
            {% if activePlan %}
                {% set current = plan.name == activePlan.name ? true : false %}
            {% else %}
                {% set current = false %}
            {% endif %}
            
            <div class="col">
                {{ plan_card.plan(
                    title: plan.name,
                    description: plan.description,
                    features: plan.features,
                    price: plan.price,
                    highlight: plan.highlighted,
                    current: current
                )}}
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}