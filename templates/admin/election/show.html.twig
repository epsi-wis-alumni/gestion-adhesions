{% extends 'admin_base.html.twig' %}

{% block title_admin %}
  Élection
{% endblock %}

{% set date_format = 'd/m/Y H:i' %}

{% block admin_content %}
  <div class="table-responsive border rounded">
    <table class="table table-striped mb-0">
      <tbody>
        <tr>
          <th>Poste</th>
          <td>{{ election.jobTitle }}</td>
        </tr>
        <tr>
          <th>Début vote</th>
          <td>{{ election.voteStartAt|date(date_format) }}</td>
        </tr>
        <tr>
          <th>Fin vote</th>
          <td>{{ election.voteEndAt|date(date_format) }}</td>
        </tr>
        <tr>
          <th>Date de création</th>
          <td>{{ election.createdAt|date(date_format) }}</td>
        </tr>
         <tr>
          <th class="border-0">Dernière mise à jour</th>
          <td>{{ election.updatedAt ? election.updatedAt|date(date_format) : 'Aucune mise à jour' }}</td>
        </tr>
      </tbody>
    </table>
  </div>
{% endblock %}
