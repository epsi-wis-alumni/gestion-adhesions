{% extends 'admin_base.html.twig' %}

{% block title_admin %}
  Élection
{% endblock %}

{% block admin_content %}
  <div class="table-responsive border rounded">
    <table class="table table-striped mb-0">
      <tbody>
        <tr>
          <th>Id</th>
          <td>{{ election.id }}</td>
        </tr>
        <tr>
          <th>JobTitle</th>
          <td>{{ election.jobTitle }}</td>
        </tr>
        <tr>
          <th>CreatedAt</th>
          <td>{{ election.createdAt ? election.createdAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        <tr>
          <th>CreatedBy</th>
          <td>{{ election.createdBy.id }}</td>
        </tr>
        <tr>
          <th>VoteStartAt</th>
          <td>{{ election.voteStartAt ? election.voteStartAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        <tr>
          <th class="border-0">VoteEndAt</th>
          <td>{{ election.voteEndAt ? election.voteEndAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
      </tbody>
    </table>
  </div>
{% endblock %}
