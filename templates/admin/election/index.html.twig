{% extends 'admin_base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}

{% block title_admin %}
  Liste des Élections
{% endblock %}

{% set date_format = 'd/m/Y H:i' %}

{% block admin_content %}
    <div class="row align-items-end gap-2 mb-3">
      <div class="col-auto me-auto">
        <h2 class="h4 mb-0">Liste des élections</h2>
      </div>

      <div class="col-auto">
        <a href="{{ path('app_admin_election_new') }}" class="btn btn-primary">
          {{ fa.icon('plus') }}
          Ajouter
        </a>
      </div>
    </div>

    <div class="table-responsive border rounded">
      <table class="table table-striped mb-0">
        <thead class="table-bordered">
          <tr>
            <th>Poste</th>
            <th>Début vote</th>
            <th>Fin vote</th>
            <th>Création</th>
            <th>Modification</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for election in elections %}
            <tr>
              <td>{{ election.jobTitle }}</td>
              <td>{{ election.voteStartAt|date(date_format) }}</td>
              <td>{{ election.voteEndAt|date(date_format) }}</td>
              <td>{{ election.createdAt|date(date_format) }}</td>
              <td>{{ election.updatedAt ? election.updatedAt|date(date_format) : 'Aucune' }}</td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <a class="link-primary" href="{{ path('app_admin_election_edit', { id: election.id }) }}">
                    {{ fa.icon('pen-to-square') }}
                  </a>
                  <a class="link-primary" href="{{ path('app_admin_election_show', { id: election.id }) }}">
                    {{ fa.icon('circle-info') }}
                  </a>
                  {% include 'admin/election/_delete.html.twig' %}
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6">Aucune Élection</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
{% endblock %}
