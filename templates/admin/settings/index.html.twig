{% extends 'admin_base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}

{% block title %}Paramètres{% endblock %}

{% block admin_content %}
  <section class="mb-5">
    <h2 class="h3 border-bottom mb-3">Cache et performances</h2>

    <p class="text-secondary">
      Après chaque déploiement, vous devez vider et régénérer le cache d'OPcache. Sinon, vous ne verrez pas les mises à jour apportées dans l'application. Étant donné qu'en PHP, la CLI et les processus Web ne partagent pas le même OPcache, vous ne pouvez effacer l'OPcache du serveur Web qu'en l'exécutant depuis le web.
    </p>
    <a href="{{ path('app_admin_settings_empty_cache') }}" class="btn btn-secondary">
      Vider le cache
    </a>
  </section>

  <section class="mb-5">
    <h2 class="h3 border-bottom mb-3">Modèles de newsletter</h2>

    <p class="text-secondary">
      Ce tableau liste des modèles de mail pour habiller le contenu des newsletters.
    </p>
    
    <div class="table-responsive border rounded mb-3">
      <table class="table table-striped">
        <thead>
          <tr>
            <th>ID</th>
            <th>Label</th>
            <th>Nom du fichier</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          {% for template in mailTemplates %}
            <tr>
              <td>{{ template.id }}</td>
              <td>{{ template.label }}</td>
              <td>{{ template.fileName }}</td>
              <td>
                <div class="d-flex gap-2">
                  <a href="{{ path('app_admin_settings_mailtemplate_edit', { id: template.id }) }}">
                    {{ fa.icon('edit') }}
                  </a>

                  {{ include('admin/mail-template/_delete.html.twig') }}
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="4">
                Aucun modèle trouvé.
              </td>
            </tr>
          
          {% endfor %}
        </tbody>
      </table>
    </div>

    <a href="{{ path('app_admin_settings_mailtemplate_new') }}" class="btn btn-secondary">Nouveau modèle</a>
  </section>
{% endblock %}
