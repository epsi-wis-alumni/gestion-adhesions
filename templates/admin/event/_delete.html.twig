{% import 'macros/fontawesome.html.twig' as fa %}
{% import "macros/modal.html.twig" as modal %}

{% set modalDeleteId = 'confirmAlert-delete-' ~ event.id %}
<form method="post" action="{{ path('app_admin_event_delete', { id: event.id }) }}">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}" />
  <a class="bg-transparent border-0 link-danger" data-bs-toggle="modal" data-bs-target="#{{ modalDeleteId }}" href="#">
    {{ fa.icon('trash-can') }}
  </a>
  {{ modal.confirm(
    id: modalDeleteId,
    title: 'Êtes-vous sûr de supprimer ?',
    continueButton: 'Supprimer',
    type: 'submit',
    accent: 'danger',
  ) }}
</form>