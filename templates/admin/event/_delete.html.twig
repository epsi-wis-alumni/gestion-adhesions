{% import 'macros/fontawesome.html.twig' as fa %}
<form method="POST" action="{{ path('app_admin_event_delete', {'id': event.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ event.id) }}" />
  <button class="bg-transparent border-0 link-danger p-0">
    {{ fa.icon('trash-can') }}
  </button>
</form>

