{% extends 'admin_base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}
{% import "macros/modal.html.twig" as modal %}

{% block title_admin %}
  Liste des Newsletters
{% endblock %}

{% set date_format = 'd/m/Y H:i' %}

{% block admin_content %}
    <div class="row align-items-end gap-2 mb-3">
        <div class="col-auto me-auto">
          <h2 class="h4 mb-0">Liste des newsletters</h2>
        </div>

        <div class="col-auto">
          <a href="{{ path('app_admin_newsletter_new') }}" class="btn btn-primary">
            {{ fa.icon('plus', swap_opacity: true) }}
            Ajouter
          </a>
        </div>
      </div>

    <div class="table-responsive border rounded">
      <table class="table table-striped mb-0">
        <thead class="table-bordered">
          <tr>
            <th>Objet</th>
            <th>CTA</th>
            <th>Création</th>
            <th>Modification</th>
            <th>Envoi</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for newsletter in newsletters %}
            <tr>
              <td>
                <div class="text-truncate text-truncate-td">
                  {{ newsletter.object }}
                </div>
              </td>
              <td>{{ newsletter.cta }}</td>
              <td>{{ newsletter.createdAt|date(date_format)}}</td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  {% set modalId = 'confirmAlert-' ~ newsletter.id %}
                  <a class="link-primary" data-bs-toggle="modal" data-bs-target="#{{ modalId }}" href="#">
                    {{ fa.icon('paper-plane') }}
                  </a>
                  {{ modal.confirm(
                    id: modalId,
                    path: path('app_admin_newsletter_send', { id: newsletter.id }),
                    title: 'Êtes-vous sur d\'envoyer ?',
                    continueButton: 'Envoyer'
                  ) }}
                  <a class="link-primary" href="{{ path('app_admin_newsletter_edit', { id: newsletter.id }) }}">
                    {{ fa.icon('pen-to-square') }}
                  </a>
                  <a class="link-primary" href="{{ path('app_admin_newsletter_show', { id: newsletter.id }) }}">
                    {{ fa.icon('circle-info') }}
                  </a>
                  {% include 'admin/newsletter/_delete.html.twig' %}
                </div>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="6">Aucune Newsletter</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
{% endblock %}
