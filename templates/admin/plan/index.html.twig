{% extends 'admin_base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}

{% block title_admin %}
    Liste des Plans
{% endblock %}

{% block admin_content %}
    <div class="row align-items-end gap-2 mb-3">
        <div class="col-auto me-auto">
          <h2 class="h4 mb-0">Liste des plans</h2>
        </div>

        <div class="col-auto">
          <a href="{{ path('app_admin_plan_new') }}" class="btn btn-primary">
            {{ fa.icon('plus', swap_opacity: true) }}
            Ajouter
          </a>
        </div>
    </div>

    <div class="table-responsive border rounded">
        <table class="table table-striped mb-0">
            <thead class="table-bordered">
                <tr>
                    <th>Nom</th>
                    <th>Description</th>
                    <th>Avantages</th>
                    <th>Coût</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for plan in plans %}
                <tr>
                    <td>{{ plan.name }}</td>
                    <td>
                        <div class="text-truncate text-truncate-td">
                            {{ plan.description }}
                        </div>
                    </td>
                    <td>{{ plan.features is not empty ? plan.features[0].name ~ '...' : 'Aucun avantages disponibles' }}</td>
                    <td>{{ plan.price }} €</td>
                    <td>
                        <div class="d-flex align-items-center gap-2">
                            <a class="link-primary" href="{{ path('app_admin_plan_edit', {'id': plan.id}) }}">
                                {{ fa.icon('pen-to-square') }}
                            </a>
                            <a class="link-primary" href="{{ path('app_admin_plan_show', {'id': plan.id}) }}">
                                {{ fa.icon('circle-info') }}
                            </a>
                            {% include 'admin/plan/_delete.html.twig' %}
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}
