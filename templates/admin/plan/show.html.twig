{% extends 'admin_base.html.twig' %}

{% block title_admin %}
    Plan
{% endblock %}

{% block admin_content %}
    <h1 class="mb-3">Plan n°{{ plan.id }}</h1>

    <div class="table-responsive border rounded">
        <table class="table table-striped mb-0">
            <tbody>
                <tr>
                    <th>Nom</th>
                    <td>{{ plan.name }}</td>
                </tr>
                <tr>
                    <th>Description</th>
                    <td>{{ plan.description }}</td>
                </tr>
                <tr>
                    <th>
                        Avantages
                    </th>
                    <td>
                        <ul class="m-0 ps-3">
                            {% if plan.features is not empty %}
                                {% for feature in plan.features %}
                                    <li>{{ feature.name }}</li>
                                {% endfor %}
                            {% endif %}
                        </ul>
                    </td>
                </tr>
                <tr>
                    <th class="border-0">Coût</th>
                    <td>{{ plan.price }} €</td>
                </tr>
            </tbody>
        </table>
    </div>
{% endblock %}
 