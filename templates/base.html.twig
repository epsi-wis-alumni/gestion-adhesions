{% import "macros/alert.html.twig" as alert %}

<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        {% block meta %}
            {% include "_meta.html.twig" %}
        {% endblock %}
        <title>{{ base_title }} - {% block title %}{% endblock %}</title>
        <link rel="stylesheet" href="{{ asset('styles/app.scss') }}">
        <link rel="icon" type="image/x-icon" href="{{ asset('images/alumni.ico') }}">
        {% block stylesheets %}
        {% endblock %}
        
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
        <script async src="https://kit.fontawesome.com/0696a64e4c.js" crossorigin="anonymous"></script>
        <script async src="https://js.stripe.com/v3/"></script>
    </head>
    <body class="bg-body-tertiary">
        {% include "_main-navbar.html.twig" %}
        
        <main>
            <div>
                {% if app.user %}
                    {% if not is_granted('ROLE_APPROVED') %}
                        <div class="container my-3">
                            {{ alert.alert(variant: 'warning', content: 'Votre demande de création de compte a bien été enregistrée. Un mail vous sera adressé lorsque votre demande aura été traitée par un administrateur.', dismissible: true) }}
                        </div>
                    {% endif %}
                    
                {% endif %}

            </div>
            {% block body %}{% endblock %}
        </main>

        {% include "_main-footer.html.twig" %}
    </body>
</html>

