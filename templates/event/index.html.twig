{% extends 'base.html.twig' %}
{% import 'macros/card_event.html.twig' as card %}

{% block title %}
  Événements
{% endblock %}

{% block body %}
  <div class="container my-5">
    <section class="mb-5">
      <h2>Prochains événements</h2>

      <div class="row">
        {% set has_pending_events = false %}

        {% if is_granted('ROLE_APPROVED') %}
          {% for event in pending_events %}
            <div class="col-sm-6 col-md-4 col-lg-3">{{ card.event(event, 1) }}</div>
            {% set has_pending_events = true %}
          {% endfor %}  
        {% else %}
          {% for event in public_pending_events %}
            <div class="col-sm-6 col-md-4 col-lg-3">{{ card.event(event, 1) }}</div>
            {% set has_pending_events = true %}
          {% endfor %}
        {% endif %}

        {% if not has_pending_events %}
          <div class="col">
            <div class="alert alert-info">Il n'y a pas encore d'événements prévus.</div>
          </div>
        {% endif %}
      </div>
    </section>

    <section class="mb-5">
      <h2>Événements en cours</h2>

      <div class="row">
        {% set has_in_progress_events = false %}

        {% if is_granted('ROLE_APPROVED') %}
          {% for event in in_progress_events %}
            <div class="col-sm-6 col-md-4 col-lg-3">{{ card.event(event, 2) }}</div>
            {% set has_in_progress_events = true %}
          {% endfor %}
        {% else %}
          {% for event in public_in_progress_events %}
            <div class="col-sm-6 col-md-4 col-lg-3">{{ card.event(event, 2) }}</div>
            {% set has_in_progress_events = true %}
          {% endfor %}
        {% endif %}

        {% if not has_in_progress_events %}
          <div class="col">
            <div class="alert alert-info">Il n'y a pas encore d'événements en cours.</div>
          </div>
        {% endif %}
      </div>
    </section>

    <section class="mb-5">
      <h2>Événements en cours</h2>

      <div class="row">
        {% set has_done_events = false %}

        {% if is_granted('ROLE_APPROVED') %}
          {% for event in done_events %}
            <div class="col-sm-6 col-md-4 col-lg-3">{{ card.event(event, 3) }}</div>
            {% set has_done_events = true %}
          {% endfor %}
        {% else %}
          {% for event in public_done_events %}
            <div class="col-sm-6 col-md-4 col-lg-3">{{ card.event(event, 3) }}</div>
            {% set has_done_events = true %}
          {% endfor %}
        {% endif %}

        {% if not has_done_events %}
          <div class="col">
            <div class="alert alert-info">Il n'y a pas encore d'événements passés.</div>
          </div>
        {% endif %}
      </div>
    </section>
  </div>
{% endblock %}
