{% extends 'base.html.twig' %}
{% import 'macros/card.html.twig' as card %}

{% block title %}
  {{ base_title }} - Liste des Évènements
{% endblock %}

{% block body %}
  <div class="container my-5">
    <section class="mb-5">
      <h2>Prochains évènements</h2>

      <div class="row">
        {% for event in pending_events %}
          <div class="col-sm-6 col-md-4 col-lg-3">{{ card.event(event, 1) }}</div>
        {% else %}
          <div class="col">
            <div class="alert alert-info">Il n'y a pas encore d'évènements prévus.</div>
          </div>
        {% endfor %}  
      </div>
    </section>

    <section class="mb-5">
      <h2>Évènements en cours</h2>

      <div class="row">
        {% for event in in_progress_events %}
          <div class="col-sm-6 col-md-4 col-lg-3">{{ card.event(event, 2) }}</div>
        {% else %}
          <div class="col">
            <div class="alert alert-info">Il n'y a pas encore d'évènements en cours.</div>
          </div>
        {% endfor %}
      </div>
    </section>

    <section class="mb-5">
      <h2>Évènements en cours</h2>

      <div class="row">
        {% for event in done_events %}
          <div class="col-sm-6 col-md-4 col-lg-3">{{ card.event(event, 3) }}</div>
        {% else %}
          <div class="col">
            <div class="alert alert-info">Il n'y a pas encore d'évènements passés.</div>
          </div>
        {% endfor %}
      </div>
    </section>
  </div>
{% endblock %}
