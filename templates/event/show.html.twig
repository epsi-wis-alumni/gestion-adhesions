{% extends 'base.html.twig' %}
{% import 'macros/fontawesome.html.twig' as fa %}
{% import "macros/fontawesome.html.twig" as fa %}

{% block title %}
  Évènement {{ event.title }}
{% endblock %}

{% set date_format = 'd/m/Y' %}
{% set hour_format = 'H:i' %}
{% set highlighted = 'fw-bold' %}

{% block body %}
  <div class="container">
    <h1 class="text-center my-5">{{ event.title }}</h1>
    <div class="row">
      <div class="col-6 d-flex flex-column justify-content-center">
        <div class="row align-items-center my-2">
          <div class="col-2">{{ fa.icon('calendar', size: 'xl') }}</div>
          <div class="col px-0">
              <div>
                Du <span class="{{ highlighted }}">{{ event.startAt|date(date_format) }}</span> 
                à <span class="{{ highlighted }}">{{ event.startAt|date(hour_format) }}</span>
              </div>
              <div>
                Au <span class="{{ highlighted }}">{{ event.endAt|date(date_format) }}</span> 
                à <span class="{{ highlighted }}">{{ event.endAt|date(hour_format) }}</span>
              </div>
          </div>
        </div>
        <hr class="my-4">
        <div class="row align-items-center my-2">
          <div class="col-2">{{ fa.icon('location-dot', size: 'xl') }}</div>
          <div class="col ps-0">{{ event.place }}</div>
        </div>
        <hr class="my-4">
        <div class="row align-items-center my-2">
          <div class="col-2">{{ fa.icon(event.private ? "lock-keyhole" : "unlock-keyhole", size: 'xl') }}</div>
          <div class="col ps-0">Évènement <span class="{{ highlighted }}">{{ event.private ? "Privé" : "Public" }}</span></div>
        </div>
      </div>
      <div class="col-6">
        <img 
              class="rounded-5 img-fluid shadow-lg" 
              src="{{ asset('assets/upload/event/images/' ~ event.imageFileName) }}" 
              alt="{{ event.imageFileName }}"
        >
      </div>
    </div>
    <h2 class="my-5">À propos</h2>
    <div class="row mb-5">
      <div class="col">
        <div style="text-align: justify">{{ event.description|markdown_to_html }}</div>
      </div>
    </div>
  </div>
{% endblock %}
