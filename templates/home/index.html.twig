{% extends 'base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}
{% import "macros/card.html.twig" as card %}

{% block title %}
  Accueil
{% endblock %}

{% block body %}
 
  <!-- Utilisateurs -->
  <div class="bg-body-primary">
    <h2 class="text-center pt-4">EPSI-WIS Alumni</h2>
    <div class="container py-5">
      <div class="text-center fs-4">
        Nous comptons déjà parmis nous de nombreux membres.
      </div>
      <div class="d-flex gap-2 align-items-center justify-content-center text-primary">
        <span class="fw-bold fs-1">
          {{ userCount }}
        </span>
        {{ fa.icon('users', size: 'xl') }}
      </div>
      <div class="d-flex align-items-center justify-content-center">
        <a class="btn btn-primary" href="{{ path('app_user_profile') }}">Voir mon profil</a>
      </div>
    </div>
  </div>

  <!-- Évènements -->
  <div class="bg-body-secondary">
    <h2 class="text-center pt-4">Élections</h2>
    <div class="container d-flex align-items-center justify-content-around my-5">
      {% for event in events %}
        {% set step = (event.startAt >= date()) ? '1' : ((event.endAt >= date()) ? '2' : '3' ) %}
        <div class="col-sm-6 col-md-4 col-lg-3">
          {{ card.event(event, step) }}
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Élections -->
  <div class="bg-body-primary">
    <h2 class="text-center pt-4">Évènements</h2>
    <div class="container d-flex align-items-center justify-content-around my-5">
      {% for election in elections %}
        {% set step = (election.voteStartAt >= date()) ? '1' : ((election.voteEndAt >= date()) ? '2' : '3' ) %}
        <div class="col-sm-6 col-md-4 col-lg-3">
          {{ card.election(election, step) }}
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Plans -->
  <div class="bg-body-secondary" id="plans">
    <h2 class="text-center pt-4">Adhésions</h2>
    {% include "/user/_plan.html.twig" %}
  </div>
  
{% endblock %}