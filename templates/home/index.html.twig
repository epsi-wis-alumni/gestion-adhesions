{% extends 'base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}
{% import "macros/card.html.twig" as card %}

{% block title %}
  Accueil
{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    This friendly message is coming from:
    <ul>
        <li>Your controller at <code>/var/www/src/Controller/HomeController.php</code></li>
        <li>Your template at <code>/var/www/templates/home/index.html.twig</code></li>
    </ul>

    <a href="{{ path('hwi_oauth_service_redirect', {'service': 'google' }) }}">
    <span>Login with Google</span>

        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'github' }) }}">
    <span>Login with github</span>

        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'azure' }) }}">
    <span>Login with azure</span>

        <a href="{{ path('hwi_oauth_service_redirect', {'service': 'linkedin' }) }}">
    <span class="btn btn-primary">Login with linkedin</span>
</a>
</div>
{% endblock %}
  <!-- Plans -->
  <div class="bg-body-secondary" id="plans">
    {% include "/user/_plan.html.twig" %}
  </div>
  
{% endblock %}