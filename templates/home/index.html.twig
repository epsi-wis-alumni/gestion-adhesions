{% extends 'base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}
{% import "macros/card.html.twig" as card %}

{% block title %}
  Accueil
{% endblock %}

{% block body %}

  <section class="py-5">
    <div class="container py-5 px-4">
      <div class="row g-5 align-items-center">
        <div class="col order-md-last">
          <img 
            class="img-fluid shadow-lg" 
            src="{{ asset('images/home/epsi-wis-2-mydil@2.webp') }}" 
            alt="Élèves de l'EPSI en classe"
            width="1248"
            height="832"
            style="border-radius: 67% 33% 14% 86% / 81% 24% 76% 19% ;"
          >
        </div>
        
        <div class="col-md-6 d-flex flex-column gap-3">
          <h1 class="display-4 fw-bold lh-1">
            Restez connectés, <br>
            progressez <span class="drawing">ensembles</span>.
          </h1>

          <p class="lead text-secondary">
            Notre réseau d'alumnis vous ouvre les portes d'une communauté engagée, prête à vous soutenir dans chaque étape de votre carrière.
          </p>

          <div>
            <a href="{{ path('app_contact') }}" class="btn btn-lg btn-primary">
              Nous contacter
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-body">
    <div class="container py-5 px-4">
      <div class="row g-5 align-items-center flex-row-reverse">
        <div class="col order-md-last">
          <img 
            class="img-fluid shadow-lg" 
            src="{{ asset('images/home/epsi-wis-1-eleves-en-classe@2.webp') }}" 
            alt="Élèves de l'EPSI en classe"
            width="1248"
            height="832"
            style="border-radius: 19% 81% 50% 50% / 69% 53% 47% 31% ;"
          >
        </div>
        
        <div class="col-md-6 d-flex flex-column gap-3">
          <h1 class="display-4 fw-bold lh-1">
            Nos Alumnis, <br>
            <span class="drawing">EPSI et WIS</span>.
          </h1>

          <p class="lead text-secondary">
            Rejoignez notre communauté d'alumni et faites avancer votre carrière avec des connexions et des opportunités qui comptent.
          </p>

          <div>
            <a href="#" class="btn btn-lg btn-primary">
              Nous rejoindre
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5">
    <div class="container py-5 px-4">
      <div class="row g-5 align-items-center mb-5">
        <div class="col order-md-last">
          <img 
            class="img-fluid shadow-lg" 
            src="{{ asset('images/home/epsi-wis-3-eleves-cafeteria@2.webp') }}" 
            alt="Élèves de l'EPSI en classe"
            width="1248"
            height="832"
            style="border-radius: 48% 52% 73% 27% / 30% 17% 83% 70% ;"
          >
        </div>
        
        <div class="col-md-6 d-flex flex-column gap-3">
          <h1 class="display-4 fw-bold lh-1">
            Des <span class="drawing">évènements</span> dédiés.
          </h1>

          <p class="lead text-secondary">
            Participez à des événements en ligne et en présentiel. Accédez à des ressources exclusives.
          </p>

        </div>
      </div>

    </div>
  </section>

  <section class="pb-5">
    <div class="container pb-5 px-4">
      <div class="row g-5 justify-content-center">
        {% for event in events %}
          {% set step = (event.startAt >= date()) ? '1' : ((event.endAt >= date()) ? '2' : '3' ) %}
          <div class="col-sm-6 col-md-4">
            {{ card.event(event, step, header_level = 2) }}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="py-5 bg-body">
    <div class="container py-5 px-4">
      <div class="row g-5 align-items-center justify-content-center text-center">
        <div class="col-md-6 d-flex flex-column gap-3">
          <h1 class="display-4 fw-bold lh-1">
            Rejoindre <span class="drawing">la team</span>.
          </h1>

          <p class="lead text-secondary">
            Rejoignez un groupe de leaders et de talents divers qui partagent vos valeurs.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-primary text-light" data-bs-theme="dark">
    <div class="container py-5 px-4">
      <div class="row g-5 justify-content-center text-center">
        <div class="col-md-6 d-flex flex-column gap-3">
          <h1 class="display-4 fw-bold lh-1">
            Des contacts, un réseau.
          </h1>

          <p>
            Rejoignez notre communauté d'alumni et faites avancer votre carrière avec des connexions et des opportunités qui comptent.
          </p>

          <div>
            <a href="#" class="btn btn-lg btn-light">
              Des offres d'emploi
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5 bg-body">
    <div class="container py-5 px-4">
      <div class="row g-5 align-items-center">
        <div class="col order-md-last">
          <img 
            class="img-fluid shadow-lg" 
            src="{{ asset('images/home/epsi-wis-4-membres-autour-dune-table@2.webp') }}" 
            alt="Élèves de l'EPSI en classe"
            width="1248"
            height="832"
            style="border-radius: 48% 52% 73% 27% / 30% 50% 50% 70% ;"
          >
        </div>
        
        <div class="col-md-6 d-flex flex-column gap-3">
          <h1 class="display-4 fw-bold lh-1">
            100 % <span class="drawing">pour vous</span>.
          </h1>

          <p class="lead text-secondary">
            Rejoignez notre communauté d'alumni et faites avancer votre carrière avec des connexions et des opportunités qui comptent.
          </p>

          <div>
            <a href="#" class="btn btn-lg btn-primary">
              Se connecter
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
 

  {% if is_granted('ROLE_USER') %}
  <!-- Utilisateurs -->
  <div class="bg-body-primary">
    <h2 class="text-center pt-4">EPSI-WIS Alumni</h2>
    <div class="container py-5">
      <div class="text-center fs-4">
        Nous comptons déjà parmis nous de nombreux membres.
      </div>
      <div class="d-flex gap-2 align-items-center justify-content-center text-primary">
        <span class="fw-bold fs-1">
          {{ userCount }}
        </span>
        {{ fa.icon('users', size: 'xl') }}
      </div>
      <div class="d-flex align-items-center justify-content-center">
        <a class="btn btn-primary" href="{{ path('app_user_profile') }}">Voir mon profil</a>
      </div>
    </div>
  </div>

  <!-- Élections -->
  <div class="bg-body-primary">
    <h2 class="text-center pt-4">Élections</h2>
    <div class="container">
      <div class="row align-items-center justify-content-around my-5">
        {% for election in elections %}
          {% set step = (election.voteStartAt >= date()) ? '1' : ((election.voteEndAt >= date()) ? '2' : '3' ) %}
          <div class="col-sm-6 col-md-4 col-lg-3">
            {{ card.election(election, step) }}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}
{% endblock %}