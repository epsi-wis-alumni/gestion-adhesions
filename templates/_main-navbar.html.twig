{% import "macros/dropdown.html.twig" as dropdown %}
{% import "macros/fontawesome.html.twig" as fa %}
{% import "macros/image.html.twig" as image %}
{% import "macros/navigation.html.twig" as navigation %}

<header class="sticky-top">
  <nav class="navbar navbar-expand-lg bg-body border-bottom shadow-sm" id="main-navbar">
    <div class="container">
      {# ----- Logo ----- #}
      <a class="navbar-brand me-5" href="{{ path('app_home') }}" aria-label="Accueil">
        <img id="main-navbar-logo" src="{{ asset('images/navbar/alumni.svg') }}" alt="Logo alumni" width="99" height="64" />
      </a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>

      <div class="collapse navbar-collapse" id="navbarSupportedContent">
        {# ----- Bouton de gauche ----- #}
        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
          {% if is_granted('ROLE_APPROVED') %}
            {{ navigation.nav_item(
              label: 'Élections',
              path: path('app_election_index'),
              icon: fa.icon('check-to-slot', size: 'lg'),
              check_path: 'app_election',
            ) }}
          {% endif %}
          
          {{ navigation.nav_item(
            label: 'Évènements',
            path: path('app_event_index'),
            icon: fa.icon('calendar-star', size: 'lg'),
            check_path: 'app_event',
          ) }}
          
          {{ navigation.nav_item(
            label: 'Donations',
            path: path('app_donnation'),
            icon: fa.icon('hand-holding-dollar', size: 'lg'),
            check_path: 'app_donnation',
          ) }}

          {% if not is_granted('ROLE_USER') %}
            {{ navigation.nav_item(
              label: 'Être adhérent',
              path: path('app_plan'),
              icon: fa.icon('user-check', size: 'lg'),
              check_path: 'null',
            ) }}

            {{ navigation.nav_item(
              label: 'Être partenaire',
              path: '#',
              icon: fa.icon('handshake', size: 'lg'),
              check_path: 'null',
            ) }}
          {% endif %}
        </ul>

        {# ----- Bouton de droite ----- #}
        {% if is_granted('ROLE_USER') %}
          <ul class="navbar-nav">
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                {{ image.avatar(app.user.avatar, size: 'sm') }}
              </a>
              <ul class="dropdown-menu dropdown-menu-end">
                {{ dropdown.header('Mon compte') }}

                {{ dropdown.item(
                  label: 'Profil',
                  path: path('app_user_profile'),
                  icon: fa.icon('user', fixed_width: true),
                ) }}
                
                {{ dropdown.item(
                  label: 'Paramètres',
                  path: path('app_user_settings'),
                  icon: fa.icon('cog', fixed_width: true),
                ) }}

                {{ dropdown.item(
                    label: 'Adhésion',
                    path: path('app_user_plan'),
                    icon: fa.icon('user-check', fixed_width: true),
                ) }}

                {{ dropdown.item(
                    label: 'Facturation',
                    path: path('app_user_invoice'),
                    icon: fa.icon('receipt', fixed_width: true),
                ) }}

                {% if is_granted('ROLE_ADMIN') %}
                  <li>
                    <hr class="dropdown-divider" />
                  </li>
                  
                  {{ dropdown.header('Administration') }}
                
                  {{ dropdown.item(
                    label: 'Utilisateurs',
                    path: path('app_admin_user_index'),
                    icon: fa.icon('users', fixed_width: true),
                  ) }}
                
                  {{ dropdown.item(
                    label: 'Élections',
                    path: path('app_admin_election_index'),
                    icon: fa.icon('check-to-slot', fixed_width: true),
                  ) }}
                
                  {{ dropdown.item(
                    label: 'Évènements',
                    path: path('app_admin_event_index'),
                    icon: fa.icon('calendar-star', fixed_width: true),
                  ) }}

                  {{ dropdown.item(
                    label: 'Newsletters',
                    path: path('app_admin_newsletter_index'),
                    icon: fa.icon('envelope', fixed_width: true),
                  ) }}

                  {{ dropdown.item(
                    label: 'Plans',
                    path: path('app_admin_plan_index'),
                    icon: fa.icon('face-tongue-money', fixed_width: true),
                  ) }}

                  {{ dropdown.item(
                    label: 'Transactions',
                    path: path('app_admin_transaction_index'),
                    icon: fa.icon('sack-dollar', fixed_width: true),
                  ) }}

                  {{ dropdown.item(
                    label: 'Paramètres',
                    path: path('app_admin_settings'),
                    icon: fa.icon('cog', fixed_width: true),
                  ) }}
                {% endif %}
                
                <li>
                  <hr class="dropdown-divider" />
                </li>
                
                {{ dropdown.header('Actions') }}

                {{ dropdown.item(
                  label: 'Déconnexion',
                  path: path('app_logout'),
                  icon: fa.icon('right-from-bracket', fixed_width: true),
                  destructive: true,
                ) }}
              </ul>
            </li>
          </ul>
        {% else %}
          <ul class="navbar-nav mb-2 mb-lg-0 list-unstyled">
            <li class="nav-item me-1">
              <a href="{{ path('app_login') }}" class="btn btn-warning mb-1 mb-lg-0">Connexion</a>
            </li>
            <li class="nav-item">
              <a href="{{ path('app_login') }}" class="btn btn-primary">Nous contacter</a>
            </li>
          </ul>
        {% endif %}
      </div>
    </div>
  </nav>
</header>
