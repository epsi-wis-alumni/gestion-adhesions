{% extends 'mail_base.html.twig' %}

{% block title %}
  Création de compte
{% endblock %}

{% block mail_content %}
  <tr>
    <td align="center">
      <table role="presentation" class="content">
        <tr>
          <td class="header">
            <h1> Création de compte</h1>
          </td>
        </tr>
        <tr>
          <td class="body">
            <p>
                Bonjour {{ user.displayName|default('') }},<br>
                Votre compte a été créé avec succès. Il est actuellement en attente de validation par un administrateur.<br>
                Vous recevrez un email de confirmation une fois que votre compte sera activé. Vous pourrez alors profiter de toutes les fonctionnalités du site.
            </p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
{% endblock %}
