{% extends 'mail_base.html.twig' %}

{% block title %}
  Facture
{% endblock %}

{% block mail_content %}
  <h5>Nouvelle Facture</h5>
  <div class="container my-2">
    <div>Une nouvelle facture est disponible {{ type.name == "Donation" ? "en pièce jointe et" : "ci-dessous et" }} sur votre espace.</div>
    {% if type.name == "Subscription" %}
      <div class="d-flex justify-content-between mb-3">
          <a class="btn btn-secondary" href="{{ invoice_url }}">Accéder à ma facture</a>
      </div>
    {% endif %}
    <div class="d-flex justify-content-between mb-3">
        <a class="btn btn-secondary" href="{{ absolute_url(path('app_user_invoice')) }}">Accéder à mon espace</a>
    </div>
  </div>
{% endblock %}
