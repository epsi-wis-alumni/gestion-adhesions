{% extends 'mail_base.html.twig' %}

{% block title %}
  Création de compte
{% endblock %}

{% block mail_content %}
  <tr>
    <td align="center">
      <table role="presentation" class="content">
        <tr>
          <td class="header">
            <h1>Votre compte est approuvé !</h1>
          </td>
        </tr>
        <tr>
          <td class="body">
            <p>
                Bonjour {{ user.firstName|default('') }} {{ user.lastName|default('') }},<br>
                Votre compte a été approuvé par un administrateur.<br>
                Vous pouvez desormais profiter de toutes les fonctionnalités du site.
            </p>

            <a class="btn btn-secondary" href="{{ absolute_url(path('app_user_profile')) }}">Accéder à mon espace</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
{% endblock %}
