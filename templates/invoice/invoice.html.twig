{% extends 'invoice_base.html.twig' %}

{% block title %}
  Facture
{% endblock %}

{% block invoice_content %}
  <div class="container">
    <div class="header">
      <h1>Facture</h1>
      <p>
        {{ alumni_name }} <br>
        {{ alumni_tel }} <br>
        {{ alumni_mail }} <br>
        {{ alumni_adress }}
      </p>
    </div>
    <div class="invoice-info">
        <h2>Informations de la facture</h2>
        <p>
            <strong>Numéro de facture :</strong> {{ transaction.invoice.invoiceId }}
        </p>
        <p>
            <strong>Date :</strong> {{ transaction.createdAt|date('d/m/Y') }}
        </p>
        <p>
            <strong>Client :</strong> {{ transaction.user.displayName }}
        </p>
        <p>
            <strong>Adresse :</strong> {{ transaction.user.email }}
        </p>
    </div>
    <table class="table">
      <thead>
        <tr>
          <th>Description</th>
          <th>Montant</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>{{ transaction.subscription ? transaction.subscription.plan.description : "Donation" }}</td>
          <td>{{ transaction.amount|number_format(2, '.', ' ') }} €</td>
        </tr>
      </tbody>
    </table>
    <div class="total">
      <strong>Total payé : {{ transaction.amount|number_format(2, '.', ' ') }} €</strong>
    </div>
    <div class="footer">
      <p>
        Merci pour votre confiance.
      </p>
    </div>
  </div>
{% endblock %}
