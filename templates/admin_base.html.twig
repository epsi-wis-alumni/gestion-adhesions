{% extends 'base.html.twig' %}
{% import "macros/fontawesome.html.twig" as fa %}

{% block title %}
    {{ base_title_admin }} - {% block title_admin %}{% endblock %}
{% endblock %}

{% block body %}
  <div class="bg-body-secondary border-bottom">
    <div class="container pt-3">
      <h1 class="mb-3">
        {{ fa.icon('crown', additional_classes: ['text-warning']) }}
        Administration
      </h1>
      {% include "admin/_admin-navbar.html.twig" %}
    </div>
  </div>

  <div class="container my-5">
    <turbo-frame id="admin-main">
      {% block admin_content %}{% endblock %}
    </turbo-frame>
  </div>
{% endblock %}
