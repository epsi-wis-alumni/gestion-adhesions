{% extends 'base.html.twig' %}
{% import "macros/job_offer_card.html.twig" as joc %}
{% import "macros/navigation.html.twig" as navigation %}
{% import "macros/fontawesome.html.twig" as fa %}

{% block title %}JobOffer index{% endblock %}

{% set date_format = 'd/m/Y H:i' %}
{% set jobOffer_status = {
    "Online": "En ligne",
    "Archived": "Archivé"
} %}
{% set jobOffer_type = {
    "Undefined": "Indéfini",
    "Internship": "Stage",
    "Apprenticeship": "Alternance",
    "CDD": "CDD",
    "CDI": "CDI"
} %}

{% block body %}
    <div class="container my-5">
        <h1 class="fw-bold text-center mb-5">Offres D'emplois</h1>
        <div class="row">
            <div class="col-auto">
                <div style="width: min(18rem, 100%);">
                    {% include "job_offer/_sidebar.html.twig" %}
                </div>
            </div>
            <div class="col">
                <div class="d-flex flex-column align-items-center">
                    {% for jobOffer in jobOffers %}
                        {{ joc.card(
                            id: jobOffer.id,
                            title: jobOffer.title,
                            description: jobOffer.description,
                            types: jobOffer.types,
                            status: jobOffer.status,
                            startAt: jobOffer.startAt,
                            endAt: jobOffer.endAt,
                            imageFilePath: jobOffer.imageFileName,
                            skills: jobOffer.skills,
                            categories: jobOffer.categories,
                            compagny: jobOffer.company,
                            country: jobOffer.country,
                            city: jobOffer.city,
                            zip_code: jobOffer.zipCode
                        ) }}
                    {% else %}
                        <div class="card mb-2" style="width: 80%;">
                            <div class="card-body">
                                <h5 class="card-title mb-4">Aucune offres a afficher. Actualisez la page ou modifiez les filtres.</h5>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    {# <div>
        <table class="table">
